<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WinPulse" Width="1320" Height="816" MinWidth="860" MinHeight="570" WindowStartupLocation="CenterScreen"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" Foreground="#F7F3FF">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#96282138"/><Setter Property="Foreground" Value="#F6EEFF"/><Setter Property="BorderBrush" Value="#685577"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/><Setter Property="FontSize" Value="15"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="face" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <Grid><Border x:Name="shine" Background="#22DAB7FF" Opacity="0" CornerRadius="4" IsHitTestVisible="False"/><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Grid>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="face" Property="BorderBrush" Value="#D3AEFF"/><Setter TargetName="shine" Property="Opacity" Value="1"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="face" Property="BorderBrush" Value="White"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="face" Property="Opacity" Value=".72"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="face" Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#FAF5FF"/><Setter Property="Padding" Value="10,7"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="item" Property="Background" Value="#A5614477"/></Trigger>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="item" Property="Background" Value="#BB73518C"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#FAF5FF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid><ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="box" Background="#8E30233F" CornerRadius="7" BorderThickness="1" BorderBrush="#9878588D">
      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Stroke="#E8D8FC" StrokeThickness="1.5" Data="M0,0 L5,5 10,0"/>
     </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#E4B9FA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Margin="12,7,34,7" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
      <Border Background="#F42C2037" CornerRadius="7" BorderThickness="1" BorderBrush="#8E705482" Margin="0,3,0,0" Padding="3" MinWidth="{Binding ActualWidth,ElementName=toggle}">
       <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border></Popup></Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PageTrackButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="12"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent">
    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
     <Track.DecreaseRepeatButton><RepeatButton x:Name="less" Style="{StaticResource PageTrackButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="grip" Background="#937E6592" CornerRadius="4" Margin="2"/>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="grip" Property="Background" Value="#C9A0C0D6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton x:Name="more" Style="{StaticResource PageTrackButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
    </Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="less" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="more" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="Expander"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
   <StackPanel><ToggleButton x:Name="header" Content="{TemplateBinding Header}" Focusable="True" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
     <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" x:Name="outline"><DockPanel>
      <Path x:Name="arrow" Stroke="#CAAFDB" StrokeThickness="1.5" Data="M1,0 L6,5 1,10" VerticalAlignment="Center" Margin="3,0,9,0" RenderTransformOrigin=".5,.5"/>
      <ContentPresenter VerticalAlignment="Center"/></DockPanel></Border>
     <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="outline" Property="BorderBrush" Value="#BDA2D1"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter x:Name="details" Visibility="Collapsed" Margin="17,6,0,0"/></StackPanel>
    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#E61D1828"/><Setter Property="Foreground" Value="#F7F3FF"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="15"/><Setter Property="BorderBrush" Value="#72637C"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#9C1C1727"/><Setter Property="Foreground" Value="#F6F1FF"/><Setter Property="RowBackground" Value="#88251E31"/><Setter Property="AlternatingRowBackground" Value="#882B2339"/><Setter Property="BorderBrush" Value="#584565"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#45384F"/><Setter Property="RowHeight" Value="34"/><Setter Property="ColumnHeaderHeight" Value="34"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#423151"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="8,4"/></Style>
 </Window.Resources>
 <Border CornerRadius="12" BorderBrush="#997B6492" BorderThickness="1" ClipToBounds="True">
  <Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#C71D1828"/><GradientStop Offset=".62" Color="#C620192D"/><GradientStop Offset="1" Color="#C52B2038"/></LinearGradientBrush></Border.Background>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Rectangle Grid.Column="1" Opacity=".04" IsHitTestVisible="False"><Rectangle.Fill>
    <DrawingBrush TileMode="Tile" Viewport="0,0,13,13" ViewportUnits="Absolute" Viewbox="0,0,13,13" ViewboxUnits="Absolute">
     <DrawingBrush.Drawing><GeometryDrawing Brush="White"><GeometryDrawing.Geometry><EllipseGeometry Center="6,6" RadiusX=".85" RadiusY=".85"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing>
    </DrawingBrush></Rectangle.Fill></Rectangle>
   <Border Grid.Column="1" IsHitTestVisible="False"><Border.Background><RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX=".7" RadiusY=".55"><GradientStop Color="#225E4579"/><GradientStop Offset="1" Color="#008951AE"/></RadialGradientBrush></Border.Background></Border>
   <Canvas Grid.ColumnSpan="2" ClipToBounds="True" IsHitTestVisible="False" Focusable="False">
    <Path Canvas.Left="34" Canvas.Top="470" Stroke="#264F3A64" StrokeThickness="1" Data="M0,36 H32 L47,22 62,58 82,0 100,68 115,34 H162"/>
   </Canvas>
   <Border Background="#70191522" BorderBrush="#52453A5F" BorderThickness="0,0,1,0" CornerRadius="12,0,0,12"/>
   <DockPanel Margin="17,24,17,18">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,34">
     <Path x:Name="BrandPulse" Data="M1,17 L9,17 14,6 19,28 24,12 28,17 35,17" Stroke="#C091FF" StrokeThickness="3" StrokeLineJoin="Round" VerticalAlignment="Center"/>
     <TextBlock x:Name="BrandTitle" Text="WinPulse" FontSize="25" FontWeight="SemiBold" Margin="9,0,0,0"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="WinPulse  7.1" Foreground="#B4A6BF" Margin="10,0,0,0"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><StackPanel x:Name="Nav"/><Border x:Name="ActivePill" Visibility="Hidden" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Width="4" Height="24" CornerRadius="2" Background="#E1BAFF"><Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#C48AFF" Opacity=".8"/></Border.Effect><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border></Grid></ScrollViewer>
   </DockPanel>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Background="Transparent">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,7,4">
      <Button x:Name="Min" Content="−" AutomationProperties.Name="Свернуть" Width="46" Height="32" FontSize="18" Padding="0" Margin="2" Background="Transparent" BorderThickness="0"/>
      <Button x:Name="Max" Content="□" AutomationProperties.Name="Развернуть или восстановить" Width="46" Height="32" FontSize="18" Padding="0" Margin="2" Background="Transparent" BorderThickness="0"/>
      <Button x:Name="CloseButton" Content="×" AutomationProperties.Name="Закрыть" Width="46" Height="32" FontSize="18" Padding="0" Margin="2" Background="Transparent" BorderThickness="0"/>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Margin="30,8,30,18"><TextBlock x:Name="Heading" FontSize="32" FontWeight="SemiBold"/><TextBlock x:Name="Intro" Foreground="#D0C3DA" FontSize="15" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
    <ContentControl Grid.Row="2" Margin="30,0,30,24" x:Name="Body" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   </Grid>
   <Grid x:Name="Splash" Grid.ColumnSpan="2" Background="#AF110B1C" Visibility="Collapsed" Panel.ZIndex="5">
    <Border CornerRadius="15" Background="#ED33263F" BorderBrush="#967D609A" BorderThickness="1" Padding="30,22" HorizontalAlignment="Center" VerticalAlignment="Center">
     <StackPanel><Path Stroke="#C99CFF" StrokeThickness="3" HorizontalAlignment="Left" Data="M0,13 L11,13 17,2 23,23 29,9 33,13 45,13"/>
      <TextBlock Text="Проверка системы" FontSize="23" FontWeight="SemiBold" Margin="0,12,0,3"/><TextBlock Text="Читаем сведения о Windows и оборудовании." Foreground="#DDCEE8"/>
     </StackPanel></Border></Grid>
  </Grid>
 </Border>
</Window>
